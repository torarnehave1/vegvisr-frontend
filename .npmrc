; Cloudflare Pages builds this repo with `npm clean-install`, which fails ERESOLVE:
; the root depends on zod@^4, while ai@4.3.19 declares peer zod@^3.23.8. Both packages
; are worker-only (dev-worker/index.js imports generateText from 'ai'; dev-worker/mcp/tools.js
; is the only zod consumer) and neither is reachable from the Vite build this flag unblocks.
;
; package-lock.json already resolves zod@4.6.5 alongside ai@4.3.19 — the tree that runs
; locally and that wrangler bundles today. This flag makes `npm ci` install exactly that lock
; instead of refusing the peer range; it changes no installed version.
;
; Verified 2026-09-29: `npm ci --dry-run` fails, `npm ci --dry-run --legacy-peer-deps` succeeds.
legacy-peer-deps=true
